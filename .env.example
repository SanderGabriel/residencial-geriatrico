# Database (MySQL 8.0+)
DATABASE_URL=mysql://root:root@localhost:3306/novo_lar_dev

# App
NODE_ENV=development
PORT=3000

# Frontend
VITE_APP_ID=novo-lar-dev
VITE_APP_TITLE="Novo Lar Financeiro"
VITE_LOG_LEVEL=debug

# Auth — OAuth Manus (or your provider)
# Set VITE_MOCK_OAUTH=true to bypass OAuth in development
VITE_MOCK_OAUTH=true
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im/login
OWNER_OPEN_ID=dev-owner
OWNER_NAME="Dev Owner"

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=change-me-in-production-minimum-32-chars

# Optional
# AWS_REGION=sa-east-1
# AWS_BUCKET_BACKUP=novo-lar-backups
