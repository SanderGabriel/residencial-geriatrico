# Banco de dados (MySQL 8 ou MariaDB 10.5+)
#
# Localmente: mysql://root:root@localhost:3306/novo_lar_dev
# Railway:    no painel, conecte o serviço MySQL e clique "Add reference" -> ${MYSQL_URL}
DATABASE_URL=mysql://root:root@localhost:3306/novo_lar_dev

# App
NODE_ENV=development
# Em produção, plataformas como Railway/Render injetam PORT automaticamente.
PORT=3000

# Frontend (bundle vai pra build, não fica como env runtime)
VITE_APP_ID=novo-lar
VITE_APP_TITLE="Novo Lar Financeiro"

# Auth — OAuth Manus ou mock em dev
# Em produção use VITE_MOCK_OAUTH=true até integrarmos OAuth real.
VITE_MOCK_OAUTH=true
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im/login
OWNER_OPEN_ID=dev-owner
OWNER_NAME="Dev Owner"

# JWT — gere uma string aleatória forte
# Comando: openssl rand -base64 32
JWT_SECRET=change-me-in-production-minimum-32-chars

# Boot automático em produção (default: true)
# Defina como "false" se quiser controlar manualmente as migrations / seed.
AUTO_MIGRATE=true
AUTO_SEED=true
